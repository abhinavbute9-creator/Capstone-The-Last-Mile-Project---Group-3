    {
      "cell_type": "code",
      "execution_count": None,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ---- C16: Rule-based recommendation engine ----\n",
        "def recommend_interventions(node_row):\n",
        "    \"\"\"Given a row of node_summary, return a ranked list of concrete,\n",
        "    human-readable interventions targeting the specific weak points\n",
        "    of that node (not a generic checklist).\"\"\"\n",
        "    recs = []\n",
        "    if node_row[\"avg_alt_mode_availability\"] < 4.5:\n",
        "        recs.append(\"Increase supply of shared autos / e-rickshaws or add a feeder-bus route\")\n",
        "    if node_row[\"avg_wait_min\"] > 14:\n",
        "        recs.append(\"Reduce feeder-bus/auto headway, especially during peak hours\")\n",
        "    if node_row[\"avg_crowding\"] > 0.55:\n",
        "        recs.append(\"Deploy additional-capacity buses to relieve platform/stand crowding\")\n",
        "    if node_row[\"avg_safety_score\"] < 5.5:\n",
        "        recs.append(\"Improve lighting, signage and visible safety presence around the node\")\n",
        "    if node_row[\"avg_infra_score\"] < 0.45:\n",
        "        recs.append(\"Upgrade footpaths, covered walkways and last-mile pedestrian infrastructure\")\n",
        "    if not recs:\n",
        "        recs.append(\"Monitor \\u2014 node is currently within acceptable service parameters\")\n",
        "    return recs\n",
        "\n",
        "pune_nodes[\"recommendations\"] = pune_nodes.apply(recommend_interventions, axis=1)\n",
        "print(\"Sample recommendations for the 5 highest-risk Pune nodes:\\n\")\n",
        "for _, r in pune_nodes.head(5).iterrows():\n",
        "    print(f\"{r['transit_node_id']}  ({r['node_type']})  \\u2014 risk {r['predicted_risk']*100:.1f}%\")\n",
        "    for rec in r[\"recommendations\"]:\n",
        "        print(f\"   \\u2022 {rec}\")\n",
        "    print()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": None,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ---- C17: Demonstration \\u2014 single commuter prediction function ----\n",
        "def predict_switch_risk(commuter_input: dict) -> dict:\n",
        "    \"\"\"Takes a single commuter/trip description (dict) and returns the\n",
        "    model's predicted probability of switching to a private vehicle,\n",
        "    plus the relevant node-level recommendations if a known node is given.\"\"\"\n",
        "    row = {f: commuter_input.get(f, np.nan) for f in FEATURES}\n",
        "    row_df = pd.DataFrame([row])\n",
        "    risk = float(rf_model.predict_proba(row_df)[:, 1][0])\n",
        "    result = {\"predicted_switch_probability\": round(risk, 3),\n",
        "              \"risk_label\": \"High\" if risk > 0.6 else \"Moderate\" if risk > 0.35 else \"Low\"}\n",
        "    return result\n",
        "\n",
        "demo_input = {\n",
        "    \"city\": \"Pune\", \"node_type\": \"Metro Station\", \"time_of_day\": \"Evening Peak (17-20)\",\n",
        "    \"day_type\": \"Weekday\", \"weather_condition\": \"Heavy Rain\",\n",
        "    \"distance_to_final_destination_km\": 3.2, \"avg_wait_time_min\": 18.0,\n",
        "    \"transit_headway_min\": 9.0, \"crowding_index\": 0.72, \"congestion_index_node\": 0.68,\n",
        "    \"last_mile_fare_inr\": 45.0, \"walk_time_min\": 22.0, \"alt_mode_availability_score\": 3.1,\n",
        "    \"app_cab_wait_time_min\": 11.0, \"safety_perception_score\": 4.8, \"last_mile_infra_score\": 0.35,\n",
        "    \"previous_negative_experience\": 1, \"trip_satisfaction_score\": 4.0,\n",
        "    \"node_latitude\": 18.55, \"node_longitude\": 73.86,\n",
        "    \"commuter_age_group\": \"25-34\", \"commuter_gender\": \"Female\",\n",
        "    \"commuter_income_bracket\": \"Middle\", \"trip_purpose\": \"Work Commute\",\n",
